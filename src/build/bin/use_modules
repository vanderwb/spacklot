#!/bin/bash
#
#   This script allows you to easily switch to this software stack's
#   build (default) or public modules

if ! (return 0 2>/dev/null); then
    >&2 echo "Error: I need to be sourced, not executed"
    exit 1
fi

# Perform script setup
export my_dir="$( cd "$(dirname "${BASH_SOURCE[0]}")" ; pwd )"
. $my_dir/../main.cfg

# If SPACKLOT_DEFAULT_MODULES is set, we assume this is a stand-alone stack
# Otherwise, we assume this is an add-on set of modules we can simply add to the module path
if [[ -n $SPACKLOT_DEFAULT_MODULES ]]; then
    # Check that system matches what we are loading if possible
    if [[ -n $HPC_SYSTEM ]]; then
        if [[ $HPC_SYSTEM != $SPACKLOT_CLUSTER ]]; then
            2>&1 echo "Error: Module stack ($SPACKLOT_CLUSTER) does not match identified host ($HPC_SYSTEM)."
            2>&1 echo -e "       No changes will be made.\n"
            return 1
        fi
    else
        2>&1 echo "Warning: System is not known (HPC_SYSTEM not set). Cannot verify stack compatibility."
    fi

    # Store old module tree for reversal
    SPACKLOT_RESET_SCRIPT=$(sed 's|\(.*envs/\).*|\1build/bin/use_modules|' <<< $LMOD_CONFIG_DIR)
    SPACKLOT_RESET_TYPE=$(sed 's|.*/\([^/]*\)/util|\1|' <<< $LMOD_CONFIG_DIR)

    if [[ ${1:-build} == p* ]]; then
        echo "Switching to public module tree:"
        mod_init=$SPACKLOT_ENV_PUBLIC/util/localinit.sh
    else
        echo "Switching to build module tree:"
        mod_init=$SPACKLOT_ENV_BUILD/util/localinit.sh
    fi

    if [[ -f $mod_init ]]; then
        # First we clean
        if [[ $(type -t module) == function ]]; then
            module --force purge
            unset MODULEPATH MODULEPATH_ROOT
            unset ${!__LMOD*} ${!LMOD*} ${!_ModuleTable*}
        fi

        # Now we use new modules
        . $mod_init
        echo -e " -> $MODULEPATH_ROOT\n"
    else
        2>&1 echo -e "Error: localinit.sh does not exist. No changes will be made.\n"
        return 1
    fi

    # Define shell function to return to default
    if [[ $(type -t reset_modules) != function ]]; then
        if [[ -f $SPACKLOT_RESET_SCRIPT ]]; then
            function reset_modules {
                . $SPACKLOT_RESET_SCRIPT $SPACKLOT_RESET_TYPE
                unset ${!SPACKLOT_RESET_*} reset_modules
            }

            echo -e "Type \"reset_modules\" to return to system module stack\n"
        else
            unset ${!SPACKLOT_RESET_*}
        fi
    fi
else
    # Lmod must exist within the current environment
    if [[ -z $LMOD_ROOT ]]; then
        2>&1 echo "Error: Module stack ($SPACKLOT_CLUSTER) requires existing Lmod. None found in environment."
        2>&1 echo -e "       No changes will be made.\n"
        return 1
    fi

    if [[ ${1:-build} == p* ]]; then
        echo "Adding modules from public module tree:"
        SPACKLOT_RESET_MODULES=$SPACKLOT_ENV_PUBLIC/modules/environment
    else
        echo "Adding modules from build module tree:"
        SPACKLOT_RESET_MODULES=$SPACKLOT_ENV_BUILD/modules/environment
    fi
    
    module use -a $SPACKLOT_RESET_MODULES
    echo -e " -> $SPACKLOT_RESET_MODULES\n"

    # Define shell function to return to default
    if [[ $(type -t reset_modules) != function ]]; then
        function reset_modules {
            module unuse $SPACKLOT_RESET_MODULES
            unset ${!SPACKLOT_RESET_*} reset_modules
        }

        echo -e "Type \"reset_modules\" to remove added modules\n"
    fi
fi
